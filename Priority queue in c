#include <stdio.h>
#define MAX 10

struct Item {
    int data;
    int priority;
};

struct Item queue[MAX];
int size = 0;

void insert() {
    int value, priority;

    if (size == MAX) {
        printf("Priority Queue Overflow\n");
        return;
    }

    printf("Enter value: ");
    if (scanf("%d", &value) != 1)
        return;

    printf("Enter priority: ");
    if (scanf("%d", &priority) != 1)
        return;

    queue[size].data = value;
    queue[size].priority = priority;
    size++;

    printf("Element inserted successfully\n");
}

void deleteHighestPriority() {
    int i, index = 0;

    if (size == 0) {
        printf("Priority Queue Underflow\n");
        return;
    }

    for (i = 1; i < size; i++) {
        if (queue[i].priority <
            queue[index].priority) {
            index = i;
        }
    }

    printf("Deleted element: %d\n",
           queue[index].data);

    for (i = index; i < size - 1; i++) {
        queue[i] = queue[i + 1];
    }

    size--;
}

void peek() {
    int i, index = 0;

    if (size == 0) {
        printf("Priority Queue is empty\n");
        return;
    }

    for (i = 1; i < size; i++) {
        if (queue[i].priority <
            queue[index].priority) {
            index = i;
        }
    }

    printf("Highest priority element: %d\n",
           queue[index].data);
}

void display() {
    int i;

    if (size == 0) {
        printf("Priority Queue is empty\n");
        return;
    }

    printf("\nElement\tPriority\n");

    for (i = 0; i < size; i++) {
        printf("%d\t%d\n",
               queue[i].data,
               queue[i].priority);
    }
}

int main() {
    int choice;

    do {
        printf("\n--- PRIORITY QUEUE MENU ---\n");
        printf("1. Insert\n");
        printf("2. Delete Highest Priority\n");
        printf("3. Peek\n");
        printf("4. Display\n");
        printf("5. Exit\n");

        printf("Enter choice: ");

        if (scanf("%d", &choice) != 1) {
            printf("Invalid input\n");
            return 1;
        }

        switch (choice) {
            case 1:
                insert();
                break;

            case 2:
                deleteHighestPriority();
                break;

            case 3:
                peek();
                break;

            case 4:
                display();
                break;

            case 5:
                printf("Exiting...\n");
                break;

            default:
                printf("Invalid choice\n");
        }

    } while (choice != 5);

    return 0;
}
